name: E2E tests

on:
  push:
    branches: ['**']
  workflow_dispatch:

jobs:
  e2e:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4

      - name: Setup sshd (port 22, password auth) + sshpass
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq sshpass
          sudo ssh-keygen -A
          echo 'PasswordAuthentication yes' | sudo tee /etc/ssh/sshd_config.d/99-e2e.conf
          sudo systemctl start ssh || sudo /usr/sbin/sshd
          (exec 3<>/dev/tcp/127.0.0.1/22) && echo "sshd OK"

      - name: Run E2E suite
        env:
          E2E_PWSH: pwsh
        run: sudo --preserve-env=E2E_PWSH pwsh -NoProfile -File tests/run-e2e.ps1

      - name: Upload test report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: e2e-report
          path: tests/REPORT.md
