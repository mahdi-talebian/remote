#!/usr/bin/env bash
# ------------------------------------------------------------------
# Mock of the Tailscale CLI - used ONLY by the end-to-end test suite.
# Faithfully emulates the behaviors the scripts rely on:
#   tailscale up --authkey <key> --hostname <name>
#   tailscale ip -4
#   tailscale status            (text)
#   tailscale status --json     (JSON)
# A real Tailscale tailnet cloud cannot be created from a test sandbox,
# so this mock stands in for the Tailscale control plane and is run in
# TWO roles (agent machine + admin machine) that share a state dir, so
# the tests can verify that BOTH SIDES SEE EACH OTHER.
#
# Configure with environment variables:
#   TS_MOCK_STATE   (required) shared state directory = the "tailnet"
#   TS_MOCK_IP      this machine's tailnet IP          (default 127.0.0.1)
#   TS_MOCK_HOST    this machine's hostname            (default mock-host)
#   TS_MOCK_TAILNET tailnet name; DEFAULT = the customer's real one:
#                   "mmdtalebian.animid@gmail.com"  (email-style -> contains '@',
#                   which is exactly the failing scenario from the field)
#   TS_MOCK_DNSNAME this machine's MagicDNS name     (default <host>.<tailnet>)
# ------------------------------------------------------------------
set -u

STATE="${TS_MOCK_STATE:?TS_MOCK_STATE is required}"
TAILNET="${TS_MOCK_TAILNET:-mmdtalebian.animid@gmail.com}"
IP="${TS_MOCK_IP:-127.0.0.1}"
HOST="${TS_MOCK_HOST:-mock-host}"
DNS="${TS_MOCK_DNSNAME:-${HOST}.${TAILNET}}"
mkdir -p "$STATE/peers"
chmod 777 "$STATE" "$STATE/peers" 2>/dev/null || true

cmd=""; authkey=""; hostname=""; json=false
while [ $# -gt 0 ]; do
  case "$1" in
    up)        cmd=up ;;
    ip)        cmd=ip ;;
    status)    cmd=status ;;
    --json)    json=true ;;
    --authkey) authkey="$2"; shift ;;
    --hostname) hostname="$2"; shift ;;
    *) : ;;  # ignore flags like --accept-dns --timeout
  esac
  shift
done

case "$cmd" in
  up)
    if [ "${authkey#tskey-auth-}" = "$authkey" ]; then
      echo "unauthorized: auth key must start with tskey-auth-" >&2
      exit 1
    fi
    name="$hostname"; [ -z "$name" ] && name="$HOST"
    printf '%s %s %s\n' "$name" "$IP" "$DNS" > "$STATE/self.txt"
    printf '%s\n' "$IP" > "$STATE/peers/$name.online"
    ;;
  ip)
    echo "$IP"
    ;;
  status)
    if $json; then
      cat <<EOF
{"CurrentTailnet":{"Name":"$TAILNET"},"Self":{"TailscaleIPs":["$IP"],"DNSName":"$DNS"}}
EOF
    else
      printf '%-15s %-30s linux   %s\n' "$IP" "$HOST" "-"
      for f in "$STATE"/peers/*.online; do
        [ -e "$f" ] || continue
        pn="$(basename "$f" .online)"
        [ "$pn" = "$HOST" ] && continue
        pip="$(cat "$f")"
        printf '%-15s %-30s linux   %s\n' "$pip" "$pn" "-"
      done
    fi
    ;;
  *)
    echo "mock tailscale: unknown command: $cmd" >&2
    exit 1
    ;;
esac
